# ShopSense — copy to .env (docker compose reads it automatically). Every value is optional
# for local use: without keys the app runs fully offline (fake LLM, mock payments).

# ---------- Security (CHANGE for any shared deployment) ----------
JWT_ACCESS_SECRET=compose-local-access-secret-change-me
JWT_REFRESH_SECRET=compose-local-refresh-secret-change-me
INTERNAL_API_KEY=compose-local-internal-key-change-me     # Next.js server -> backend (OAuth exchange)
NEXTAUTH_SECRET=compose-local-nextauth-secret-change-me
REVALIDATE_SECRET=compose-local-revalidate-secret          # backend -> frontend ISR revalidation
MEILI_MASTER_KEY=shopsense-dev-master-key-change-me

# ---------- LLM provider: fake | openai | anthropic | gemini | ollama ----------
LLM_PROVIDER=fake
LLM_MODEL=                 # defaults: claude-opus-5-5 / gpt-4o-mini / gemini-2.5-flash / llama3.1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- Payments (empty secret key => mock mode with signed fake webhooks) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=shopsense-mock-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Google sign-in via NextAuth (provider hidden when empty) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- ML ----------
TRAIN_CRON=0 2 * * *       # nightly retraining; "off" disables
EMBEDDER=lsa               # lsa | hashing | sentence-transformers (needs the ml "transformers" extra)

# ---------- Local (non-docker) development: backend/.env ----------
# DATABASE_URL=postgresql://shopsense:shopsense@localhost:20610/shopsense
# REDIS_URL=redis://localhost:20611
# MEILI_HOST=http://localhost:20612
# ML_SERVICE_URL=http://localhost:20602
# PORT=20601
