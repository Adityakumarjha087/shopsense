# Browser → backend origin (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:20601
# Server (RSC / NextAuth) → backend origin; in docker compose: http://backend:4000
API_INTERNAL_URL=http://localhost:20601
NEXTAUTH_URL=http://localhost:20600
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Must match the backend INTERNAL_API_KEY (Google sign-in token exchange)
INTERNAL_API_KEY=dev-internal-api-key-change-me
# Must match the backend FRONTEND_REVALIDATE_SECRET (on-demand ISR)
REVALIDATE_SECRET=change-me
# Optional: Google sign-in (button hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Stripe Elements (mock card form is used when unset)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
