# ShopSense ML service (all optional; defaults shown)
DATABASE_URL=postgresql://shopsense:shopsense@localhost:20610/shopsense
MODEL_DIR=./artifacts
MLFLOW_TRACKING_URI=http://localhost:20613
MLFLOW_EXPERIMENT=shopsense-recommender
# lsa | hashing | sentence-transformers (needs `uv sync --extra transformers`)
EMBEDDER=lsa
EMBEDDING_DIM=96
TRAIN_CRON=0 2 * * *
TRAIN_ON_STARTUP=true
# retry interval for the first training when the DB is still empty
EVAL_K=10
ALS_FACTORS=32
ALS_REGULARIZATION=0.05
ALS_ALPHA=20
ALS_ITERATIONS=15
POPULARITY_HALF_LIFE_DAYS=14
RULES_MIN_SUPPORT=0.002
RULES_MIN_CONFIDENCE=0.05
LOG_LEVEL=INFO
LOG_JSON=true
BOOTSTRAP_RETRY_SECONDS=30
